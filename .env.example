# Copia este archivo como .env y completa. El .env NO se sube a GitHub.
#
# Claude va por la API de Anthropic, sin claves de API:
#  - local: `ant auth login` una vez; el SDK usa ese perfil y aqui no va nada.
#  - produccion en Azure: Workload Identity Federation con la Managed Identity
#    del Container App. Ninguno de estos valores es secreto: son identificadores.
# Azure (Table, Blob, Speech) sigue con Entra ID: `az login` en local.

# Modelo de Claude (por defecto claude-opus-5)
CLAUDE_MODEL=claude-opus-5

# --- Solo en produccion (Container App). Vacios en local. ---
# Identifier URI de la app registration de Entra que representa a la API de Claude.
ANTHROPIC_ENTRA_AUDIENCE=
# IDs que da el asistente "Connect workload" de la Console de Anthropic.
ANTHROPIC_FEDERATION_RULE_ID=
ANTHROPIC_ORGANIZATION_ID=
ANTHROPIC_SERVICE_ACCOUNT_ID=
ANTHROPIC_WORKSPACE_ID=

# Solo para hostings sin proveedor de identidad (Hugging Face, Render...).
# Con ANTHROPIC_ENTRA_AUDIENCE definida no se usa.
# ANTHROPIC_API_KEY=

# Puerto del servidor (opcional)
PORT=3000

# Persistencia opcional (Azure Table Storage con Managed Identity, sin claves).
# Si se deja vacio, el servidor guarda las sesiones solo en memoria.
# De aqui salen dos tablas: 'sessions' (caduca a los 7 dias) y 'uso' (perpetua).
AZURE_TABLES_ENDPOINT=

# Token que abre GET /api/uso, el desglose de uso por campana. Sin el, la ruta
# responde 404: el detalle de quien invito a quien no es publico.
USO_TOKEN=
