# Copia este archivo como .env y completa. El .env NO se sube a GitHub.
# No hay claves de API: la autenticacion es con Entra ID (az login en local,
# Managed Identity en Azure Container Apps).

# Nombre del recurso de Azure AI Foundry (no la URL, solo el nombre)
ANTHROPIC_FOUNDRY_RESOURCE=

# Nombre del deployment del modelo en Foundry
CLAUDE_DEPLOYMENT=claude-opus-5

# Puerto del servidor (opcional)
PORT=3000

# Persistencia opcional (Azure Table Storage con Managed Identity, sin claves).
# Si se deja vacio, el servidor guarda las sesiones solo en memoria.
AZURE_TABLES_ENDPOINT=
